<svg xmlns="http://www.w3.org/2000/svg" width="600" height="750" viewBox="0 0 600 750">
    <defs>
        <linearGradient id="bgGrad2" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" stop-color="#FFF8E7"/>
            <stop offset="50%" stop-color="#FFE3E8"/>
            <stop offset="100%" stop-color="#FFD1DC"/>
        </linearGradient>
    </defs>
    <rect width="600" height="750" fill="url(#bgGrad2)"/>
    <circle cx="300" cy="320" r="160" fill="#FF6F91" opacity="0.3"/>
    
    <g transform="translate(300, 310)">
        <path d="M 0,-40 C -80,-120 -200,-40 0,90 C 200,-40 80,-120 0,-40 Z" fill="#FF6F91"/>
        <text x="0" y="20" text-anchor="middle" font-family="'Outfit', sans-serif" font-size="60" fill="#FFFFFF">✨</text>
    </g>
    
    <text x="300" y="540" text-anchor="middle" font-family="'Dancing Script', cursive, sans-serif" font-size="46" font-weight="bold" fill="#4A2732">That Beautiful Smile 💕</text>
    <text x="300" y="590" text-anchor="middle" font-family="'Outfit', sans-serif" font-size="20" fill="#8C596B">Replace with your photo in assets/photos/photo2.jpg</text>
