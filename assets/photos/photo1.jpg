<svg xmlns="http://www.w3.org/2000/svg" width="600" height="750" viewBox="0 0 600 750">
    <defs>
        <linearGradient id="bgGrad" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" stop-color="#FFE8EE"/>
            <stop offset="50%" stop-color="#FFF5F7"/>
            <stop offset="100%" stop-color="#FFF9F5"/>
        </linearGradient>
    </defs>
    <rect width="600" height="750" fill="url(#bgGrad)"/>
    <circle cx="300" cy="320" r="180" fill="#FFB7C5" opacity="0.4"/>
    
    <!-- Cute Heart & Panda Graphic -->
    <g transform="translate(300, 310)">
        <path d="M 0,-40 C -80,-120 -200,-40 0,90 C 200,-40 80,-120 0,-40 Z" fill="#FF4F81"/>
        <text x="0" y="20" text-anchor="middle" font-family="'Outfit', sans-serif" font-size="60" fill="#FFFFFF">🐼</text>
    </g>
    
    <text x="300" y="540" text-anchor="middle" font-family="'Dancing Script', cursive, sans-serif" font-size="46" font-weight="bold" fill="#4A2732">Our Memory 💕</text>
    <text x="300" y="590" text-anchor="middle" font-family="'Outfit', sans-serif" font-size="20" fill="#8C596B">Replace with your favorite photo of Sadalika!</text>
</svg>
